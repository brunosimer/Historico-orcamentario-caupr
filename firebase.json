{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/lab-bootstrap.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/lab.css", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "southamerica-east1",
    "edition": "standard"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
